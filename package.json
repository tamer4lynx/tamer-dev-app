{
  "name": "@tamer4lynx/tamer-dev-app",
  "private": true,
  "version": "0.0.20",
  "type": "module",
  "description": "Standalone Tamer4Lynx dev app - Expo Go-style QR scan and HMR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamer4lynx/tamer-dev-app.git"
  },
  "homepage": "https://github.com/tamer4lynx/tamer-dev-app#readme",
  "bugs": {
    "url": "https://github.com/tamer4lynx/tamer-dev-app/issues"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "build:client": "node scripts/build-dev-client-bundle.cjs",
