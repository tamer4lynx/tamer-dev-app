    "@tamer4lynx/tamer-system-ui": "^0.0.4",
    "@tamer4lynx/tamer-asset": "file:../tamer-asset",
    "@tamer4lynx/tamer-webview": "^0.0.2",
    "@tamer4lynx/tamer-transports": "^0.0.9",
    "@tamer4lynx/tamer-linking": "^0.0.5",
    "@tamer4lynx/tamer-local-storage": "^0.0.4",
    "@tamer4lynx/tamer-secure-store": "^0.0.3",
    "@tamer4lynx/tamer-biometric": "^0.0.2",
    "@tamer4lynx/tamer-display-browser": "^0.0.5",
