    "link:native": "node ../../dist/index.js link",
    "build:android": "node ../../dist/index.js build android -d",
    "build:ios": "node ../../dist/index.js build ios -d"
  },
  "dependencies": {
    "@tamer4lynx/tamer-dev-client": "^0.0.29",
