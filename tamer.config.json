{
  "android": {
    "appName": "Tamer App",
    "packageName": "com.nanofuxion.tamerdevapp"
  },
  "ios": {
    "appName": "Tamer App",
    "bundleId": "com.nanofuxion.tamerdevapp"
  },
  "icon": {
    "source": "src/assets/tamer-logo.png",
    "androidAdaptive": {
      "foreground": "src/assets/tamer-logo.png",
      "backgroundColor": "#000000",
      "foregroundFit": "contain",
      "foregroundScale": 0.62,
      "foregroundPadding": 6
    }
  },
  "paths": {
    "androidDir": "android",
    "iosDir": "ios",
    "lynxBundleRoot": "dist",
    "lynxBundleFile": "dev-client.lynx.bundle"
  },
  "autolink": true
}
